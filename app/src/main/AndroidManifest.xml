<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Needed only for the in-app "send test notification" button (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Lets the app talk to Shizuku, which performs the privileged status-bar calls on our
         behalf. Optional at runtime: everything except the Status bar screen works without it. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Makes launchable apps visible to the package manager on Android 11+, so the Apps screen
         can list them for the per-app allow/mute switches. The explicit Shizuku entry is what
         lets us tell "not installed" apart from "installed but not running". -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".ExpressiveCutoutApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpressiveCutout">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ExpressiveCutout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shizuku's own initialisation hook: it binds this provider to hand our process the
             privileged binder. Required by the Shizuku API, not something we call ourselves. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Hosts the always-on cutout overlay via TYPE_ACCESSIBILITY_OVERLAY, which is why an
             accessibility service is used at all: it removes the need for SYSTEM_ALERT_WINDOW.

             This service may read screen content, for features only: it takes the foreground
             app's package name (so tiles can react to it), and reads answer text out of known
             assistant apps for the assistant tile. Nothing read is stored or transmitted, and
             the app declares no INTERNET permission. See res/xml/accessibility_service_config.xml
             for the exact scope. -->
        <service
            android:name=".service.CutoutAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Handles the buttons on the in-app test notification (reply / mark as read). -->
        <receiver
            android:name=".notifications.TestReplyReceiver"
            android:exported="false" />

        <!-- Ends the in-app test call when its hang-up button is tapped. -->
        <receiver
            android:name=".notifications.TestCallReceiver"
            android:exported="false" />

        <!-- Captures posted notifications and forwards them to the island. -->
        <service
            android:name=".service.CutoutNotificationListenerService"
            android:exported="false"
            android:label="@string/notification_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
