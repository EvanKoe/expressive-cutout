<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Needed only for the in-app "send test notification" button (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        A notification's icon comes from the notification itself; this scoped query is what
        lets us resolve the posting app's *name* (and its launcher icon, as the fallback for a
        notification carrying no icon of its own) — plus the media player's name and icon for
        the music tile, which arrives from a media session rather than a notification. Limited
        to apps with a launcher entry, so it avoids the restricted QUERY_ALL_PACKAGES.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ExpressiveCutoutApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpressiveCutout">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ExpressiveCutout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hosts the always-on cutout overlay via TYPE_ACCESSIBILITY_OVERLAY. -->
        <service
            android:name=".service.CutoutAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Handles the buttons on the in-app test notification (reply / mark as read). -->
        <receiver
            android:name=".notifications.TestReplyReceiver"
            android:exported="false" />

        <!-- Ends the in-app test call when its hang-up button is tapped. -->
        <receiver
            android:name=".notifications.TestCallReceiver"
            android:exported="false" />

        <!-- Captures posted notifications and forwards them to the island. -->
        <service
            android:name=".service.CutoutNotificationListenerService"
            android:exported="false"
            android:label="@string/notification_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
